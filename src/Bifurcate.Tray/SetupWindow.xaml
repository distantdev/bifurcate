<Window x:Class="Bifurcate.Tray.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bifurcate Settings"
        Width="730"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

  <StackPanel Margin="20,16,20,18">

    <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,16" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Tunnel & Routing -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Tunnel &amp; Routing" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

        <TextBlock Text="VPN connection" Margin="0,0,0,4" />
        <ComboBox x:Name="VpnList" Height="26" SelectionChanged="OnVpnSelectionChanged" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="The Windows VPN connection to manage." />

        <TextBlock Text="Tunnel subnets" Margin="0,0,0,4" />
        <TextBox x:Name="RoutesBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="Comma separated (e.g. 10.0.0.0/16). Routes that use the tunnel in Subnet Only mode." />

        <TextBlock Text="Tunnel hosts" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="HostsBox" Height="26" VerticalContentAlignment="Center" />
          <Button x:Name="RefreshDnsButton" Grid.Column="1" Content="Refresh DNS" Width="96" Margin="6,0,0,0"
                  Click="OnRefreshDnsClick" ToolTip="Re-resolve tunnel hosts and drop remembered extra IPs that DNS no longer returns." />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="Comma separated names. Each is a /32. Use Refresh DNS to sync now." />

        <TextBlock Text="Bypass domains" Margin="0,0,0,4" />
        <TextBox x:Name="BypassDomainsBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="Comma separated domain suffixes (e.g. home.arpa, local) resolved by LAN DNS." />

        <TextBlock Text="Bypass DNS (optional)" Margin="0,0,0,4" />
        <TextBox x:Name="BypassDnsBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                   Text="Optional comma separated DNS IPs. Leave blank to auto-detect from LAN/Wi-Fi." />
      </StackPanel>

      <!-- Vertical Divider Line -->
      <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center"
                 Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,4,0,4" />

      <!-- Right Column: Health Check & General Settings -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="Health &amp; General" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

        <TextBlock Text="Health check" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="ProbeTypeList" Grid.Column="0" Height="26" Margin="0,0,6,0"
                    SelectionChanged="OnProbeTypeChanged" />
          <TextBox x:Name="ProbeHostBox" Grid.Column="1" Height="26" Margin="0,0,6,0"
                   VerticalContentAlignment="Center" Style="{DynamicResource DefaultTextBoxBaseStyle}" />
          <TextBox x:Name="ProbePortBox" Grid.Column="2" Height="26" Margin="0,0,6,0"
                   VerticalContentAlignment="Center" Style="{DynamicResource DefaultTextBoxBaseStyle}" />
          <Button x:Name="TestButton" Grid.Column="3" Content="Test" Width="56" Click="OnTestClick" />
        </Grid>
        <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="A host inside the tunnel that answers. Keep this inside the subnets." />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Recheck every" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="IntervalBox" Width="56" Height="26" VerticalContentAlignment="Center"
                       Style="{DynamicResource DefaultTextBoxBaseStyle}" />
              <TextBlock Text="sec" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="Privacy (hardening)" Margin="0,0,0,4" />
            <ComboBox x:Name="HardeningList" Height="26" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Public IP service" Margin="0,0,0,4" />
        <TextBox x:Name="PublicIpBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,10"
                   Text="Optional. Shows the address the outside world sees. Leave blank to skip." />

        <Grid Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Startup" Margin="0,0,0,4" />
            <ComboBox x:Name="StartupList" Height="26" SelectionChanged="OnStartupChanged" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                       Text="Start at sign-in." />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Theme" Margin="0,0,0,4" />
            <ComboBox x:Name="ThemeList" Height="26" SelectionChanged="OnThemeChanged" />
          </StackPanel>
        </Grid>

      </StackPanel>
    </Grid>

    <Separator Margin="0,18,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SaveButton" Content="Save" Width="110" Margin="0,0,10,0" IsDefault="True"
              Click="OnSaveClick" />
      <Button Content="Cancel" Width="110" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>

  </StackPanel>
</Window>
